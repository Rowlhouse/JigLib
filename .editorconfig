root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,inl,txt,cmake,json,md,yml,yaml,cfg}]
indent_style = space
indent_size = 2

[*.{cpp,hpp,h,inl}]
max_line_length = 120

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.{bat,sln,vcxproj,filters}]
end_of_line = crlf
